# Copy this file to .env and fill in real values. Never commit .env.

# OpenAI (used by LangChain for the LLM and embeddings)
OPENAI_API_KEY=sk-your-key-here

# Langfuse tracing (from your Langfuse project settings)
LANGFUSE_PUBLIC_KEY=pk-lf-your-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-key-here
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Where our own FastAPI app runs (the agent calls the order/helpdesk APIs here)
APP_BASE_URL=http://localhost:8000

# Optional: which OpenAI chat model the agent uses
OPENAI_MODEL=gpt-4o-mini
